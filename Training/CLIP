#!/usr/bin/env python3
import os
import csv
import math
import time
import random
import argparse
from dataclasses import dataclass
from typing import List, Dict, Tuple

import torch
import torch.nn as nn
import torch.nn.functional as F
from torch.utils.data import Dataset, DataLoader
from PIL import Image

import open_clip


def set_seed(seed: int):
    random.seed(seed)
    torch.manual_seed(seed)
    torch.cuda.manual_seed_all(seed)


def ensure_dir(path: str):
    os.makedirs(path, exist_ok=True)


def read_csv_rows(path: str):
    rows = []
    with open(path, "r", encoding="utf-8", newline="") as f:
        reader = csv.DictReader(f)
        for row in reader:
            rows.append(row)
    return rows


@dataclass
class WBItem:
    img_path: str
    y: int
    place: int
    split: int


class WaterbirdsDataset(Dataset):
    """
    WILDS Waterbirds metadata usually has:
      img_filename, y, place, split
    split: 0=train, 1=val, 2=test
    """
    def __init__(self, root_dir: str, metadata_csv: str, preprocess, split_name: str):
        self.root_dir = root_dir
        self.preprocess = preprocess
        self.items: List[WBItem] = []

        split_map = {"train": 0, "val": 1, "test": 2}
        target_split = split_map[split_name]

        rows = read_csv_rows(metadata_csv)
        for r in rows:
            if int(r["split"]) != target_split:
                continue
            img_path = os.path.join(root_dir, r["img_filename"])
            self.items.append(
                WBItem(
                    img_path=img_path,
                    y=int(r["y"]),
                    place=int(r["place"]),
                    split=int(r["split"]),
                )
            )

    def __len__(self):
        return len(self.items)

    def __getitem__(self, idx):
        item = self.items[idx]
        image = Image.open(item.img_path).convert("RGB")
        image = self.preprocess(image)
        return {
            "image": image,
            "y": item.y,
            "place": item.place,
            "img_path": item.img_path,
        }


class WaterbirdsPAUDataset(Dataset):
    """
    For CLIP-based PAU on Waterbirds:
    - method=mist: expects retain/ forget folders with class subdirs
    - method=probe: expects retain/forget with original_yes/original_no nesting OK
    - method=cord: expects retain/forget class dirs

    Labels are bird labels:
      class_names order must match folder names
    """
    def __init__(self, data_root: str, split_type: str, preprocess):
        self.preprocess = preprocess
        self.samples = []
        base = os.path.join(data_root, split_type)
        if not os.path.isdir(base):
            return

        for root, _, files in os.walk(base):
            if len(files) == 0:
                continue
            class_name = os.path.basename(root)
            for fn in files:
                low = fn.lower()
                if low.endswith((".jpg", ".jpeg", ".png", ".bmp", ".webp")):
                    self.samples.append((os.path.join(root, fn), class_name))

    def __len__(self):
        return len(self.samples)

    def __getitem__(self, idx):
        img_path, class_name = self.samples[idx]
        image = Image.open(img_path).convert("RGB")
        image = self.preprocess(image)
        return {
            "image": image,
            "class_name": class_name,
            "img_path": img_path,
        }


class CLIPClassifier(nn.Module):
    def __init__(self, clip_model, embed_dim: int, num_classes: int = 2):
        super().__init__()
        self.clip_model = clip_model
        self.classifier = nn.Linear(embed_dim, num_classes)

    def forward(self, images):
        feats = self.clip_model.encode_image(images)
        feats = feats / feats.norm(dim=-1, keepdim=True).clamp_min(1e-6)
        logits = self.classifier(feats)
        return logits


def get_group(y: torch.Tensor, place: torch.Tensor):
    # standard Waterbirds 4 groups:
    # y=0/1, place=0/1
    return y * 2 + place


def compute_avg_and_wga(logits: torch.Tensor, y: torch.Tensor, place: torch.Tensor):
    pred = logits.argmax(dim=1)
    correct = (pred == y).float()

    avg_acc = correct.mean().item() * 100.0

    groups = get_group(y, place)
    wga = 100.0
    for g in range(4):
        mask = groups == g
        if mask.any():
            acc = correct[mask].mean().item() * 100.0
            wga = min(wga, acc)
    return avg_acc, wga


def evaluate(model, loader, device):
    model.eval()
    all_logits, all_y, all_place = [], [], []
    with torch.no_grad():
        for batch in loader:
            images = batch["image"].to(device)
            y = batch["y"].to(device)
            place = batch["place"].to(device)
            logits = model(images)
            all_logits.append(logits)
            all_y.append(y)
            all_place.append(place)

    logits = torch.cat(all_logits, dim=0)
    y = torch.cat(all_y, dim=0)
    place = torch.cat(all_place, dim=0)
    avg_acc, wga = compute_avg_and_wga(logits, y, place)
    return avg_acc, wga


def train_finetune_clip(args):
    device = torch.device(args.device if torch.cuda.is_available() else "cpu")

    model_name = "RN50"
    clip_model, _, preprocess = open_clip.create_model_and_transforms(
        model_name,
        pretrained="openai"
    )
    embed_dim = clip_model.text_projection.shape[1] if hasattr(clip_model, "text_projection") and clip_model.text_projection is not None else clip_model.visual.output_dim

    model = CLIPClassifier(clip_model, embed_dim=embed_dim, num_classes=2).to(device)

    train_ds = WaterbirdsDataset(args.image_root, args.metadata_csv, preprocess, "train")
    val_ds = WaterbirdsDataset(args.image_root, args.metadata_csv, preprocess, "val")
    test_ds = WaterbirdsDataset(args.image_root, args.metadata_csv, preprocess, "test")

    train_loader = DataLoader(train_ds, batch_size=args.batch_size, shuffle=True, num_workers=args.num_workers)
    val_loader = DataLoader(val_ds, batch_size=args.batch_size, shuffle=False, num_workers=args.num_workers)
    test_loader = DataLoader(test_ds, batch_size=args.batch_size, shuffle=False, num_workers=args.num_workers)

    optimizer = torch.optim.AdamW(model.parameters(), lr=args.lr, weight_decay=args.weight_decay)
    best_wga = -1.0
    best_path = os.path.join(args.output_dir, "best_finetune.pt")
    ensure_dir(args.output_dir)

    for epoch in range(1, args.epochs + 1):
        model.train()
        running = 0.0
        for batch in train_loader:
            images = batch["image"].to(device)
            y = batch["y"].to(device)

            logits = model(images)
            loss = F.cross_entropy(logits, y)

            optimizer.zero_grad()
            loss.backward()
            optimizer.step()

            running += loss.item()

        val_avg, val_wga = evaluate(model, val_loader, device)
        print(f"[finetune][epoch {epoch}] loss={running/len(train_loader):.4f} val_avg={val_avg:.2f} val_wga={val_wga:.2f}")

        if val_wga > best_wga:
            best_wga = val_wga
            torch.save(model.state_dict(), best_path)

    model.load_state_dict(torch.load(best_path, map_location=device))
    test_avg, test_wga = evaluate(model, test_loader, device)
    print(f"[finetune][test] avg={test_avg:.2f} wga={test_wga:.2f}")


def train_pau_clip(args):
    device = torch.device(args.device if torch.cuda.is_available() else "cpu")

    model_name = "RN50"
    clip_model, _, preprocess = open_clip.create_model_and_transforms(
        model_name,
        pretrained="openai"
    )
    embed_dim = clip_model.text_projection.shape[1] if hasattr(clip_model, "text_projection") and clip_model.text_projection is not None else clip_model.visual.output_dim

    model = CLIPClassifier(clip_model, embed_dim=embed_dim, num_classes=2).to(device)
    ref_model = None

    if args.algo in {"kl", "npo"}:
        ref_clip, _, _ = open_clip.create_model_and_transforms(model_name, pretrained="openai")
        ref_model = CLIPClassifier(ref_clip, embed_dim=embed_dim, num_classes=2).to(device)
        ref_model.eval()
        for p in ref_model.parameters():
            p.requires_grad = False

    retain_ds = WaterbirdsPAUDataset(args.pau_root, "retain", preprocess)
    forget_ds = WaterbirdsPAUDataset(args.pau_root, "forget", preprocess)
    forget_neg_ds = WaterbirdsPAUDataset(args.pau_root, "forget_neg", preprocess) if args.use_forget_neg else None

    train_wb = WaterbirdsDataset(args.image_root, args.metadata_csv, preprocess, "train")
    val_wb = WaterbirdsDataset(args.image_root, args.metadata_csv, preprocess, "val")
    test_wb = WaterbirdsDataset(args.image_root, args.metadata_csv, preprocess, "test")

    retain_loader = DataLoader(retain_ds, batch_size=args.batch_size, shuffle=True, num_workers=args.num_workers)
    forget_loader = DataLoader(forget_ds, batch_size=args.batch_size, shuffle=True, num_workers=args.num_workers)
    forget_neg_loader = DataLoader(forget_neg_ds, batch_size=args.batch_size, shuffle=True, num_workers=args.num_workers) if forget_neg_ds is not None and len(forget_ds) > 0 else None

    val_loader = DataLoader(val_wb, batch_size=args.batch_size, shuffle=False, num_workers=args.num_workers)
    test_loader = DataLoader(test_wb, batch_size=args.batch_size, shuffle=False, num_workers=args.num_workers)

    optimizer = torch.optim.AdamW(model.parameters(), lr=args.lr, weight_decay=args.weight_decay)
    ensure_dir(args.output_dir)

    def endless(loader):
        while True:
            for b in loader:
                yield b

    r_it = endless(retain_loader)
    f_it = endless(forget_loader)
    fn_it = endless(forget_neg_loader) if forget_neg_loader is not None else None

    class_to_idx = {name: i for i, name in enumerate(args.class_names.split(","))}

    def targets_from_classnames(names):
        y = []
        for n in names:
            n = n.strip()
            if n not in class_to_idx:
                raise ValueError(f"Unknown class name in PAU split: {n}")
            y.append(class_to_idx[n])
        return torch.tensor(y, dtype=torch.long, device=device)

    def kl_div_logits(cur, ref):
        p = F.log_softmax(cur, dim=-1)
        q = F.softmax(ref, dim=-1)
        return F.kl_div(p, q, reduction="batchmean")

    best_wga = -1.0
    best_path = os.path.join(args.output_dir, f"best_{args.algo}.pt")

    total_steps = args.epochs * args.steps_per_epoch
    for step in range(1, total_steps + 1):
        model.train()

        rb = next(r_it)
        fb = next(f_it)
        fnb = next(fn_it) if fn_it is not None else None

        r_img = rb["image"].to(device)
        r_y = targets_from_classnames(rb["class_name"])

        f_img = fb["image"].to(device)
        f_y = targets_from_classnames(fb["class_name"])

        r_logits = model(r_img)
        f_logits = model(f_img)

        if args.algo == "ga":
            retain_loss = F.cross_entropy(r_logits, r_y)
            forget_loss = F.cross_entropy(f_logits, f_y)
            loss = retain_loss + args.lambda_forget * forget_loss

        elif args.algo == "kl":
            retain_loss = F.cross_entropy(r_logits, r_y)
            with torch.no_grad():
                ref_r = ref_model(r_img)
            forget_loss = F.cross_entropy(f_logits, f_y)
            kl_loss = kl_div_logits(r_logits, ref_r)
            loss = args.lambda_forget * forget_loss + args.beta_kl * kl_loss + retain_loss

        elif args.algo == "npo":
            retain_loss = F.cross_entropy(r_logits, r_y)
            with torch.no_grad():
                ref_f = ref_model(f_img)

            cur_logp = F.log_softmax(f_logits, dim=-1).gather(1, f_y.unsqueeze(1)).mean()
            ref_logp = F.log_softmax(ref_f, dim=-1).gather(1, f_y.unsqueeze(1)).mean()
            beta = args.beta_npo
            npo_term = torch.log1p(torch.exp(beta * (cur_logp - ref_logp))) / beta
            loss = retain_loss + args.lambda_forget * npo_term

        else:
            raise ValueError(args.algo)

        if fnb is not None:
            fn_img = fnb["image"].to(device)
            fn_y = targets_from_classnames(fnb["class_name"])
            fn_logits = model(fn_img)
            neg_loss = F.cross_entropy(fn_logits, fn_y)
            loss = loss + args.gamma_neg * neg_loss

        optimizer.zero_grad()
        loss.backward()
        optimizer.step()

        if step % args.log_every == 0 or step == 1:
            val_avg, val_wga = evaluate(model, val_loader, device)
            print(f"[{args.algo}][step {step}/{total_steps}] loss={loss.item():.4f} val_avg={val_avg:.2f} val_wga={val_wga:.2f}")

            if val_wga > best_wga:
                best_wga = val_wga
                torch.save(model.state_dict(), best_path)

    model.load_state_dict(torch.load(best_path, map_location=device))
    test_avg, test_wga = evaluate(model, test_loader, device)
    print(f"[{args.algo}][test] avg={test_avg:.2f} wga={test_wga:.2f}")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--mode", choices=["finetune", "pau"], required=True)

    ap.add_argument("--image_root", required=True)
    ap.add_argument("--metadata_csv", required=True)
    ap.add_argument("--output_dir", required=True)

    ap.add_argument("--pau_root", type=str, default="")
    ap.add_argument("--algo", choices=["ga", "kl", "npo"], default="npo")

    ap.add_argument("--class_names", type=str, default="landbird,waterbird")
    ap.add_argument("--device", type=str, default="cuda:0")
    ap.add_argument("--epochs", type=int, default=5)
    ap.add_argument("--steps_per_epoch", type=int, default=200)
    ap.add_argument("--batch_size", type=int, default=64)
    ap.add_argument("--num_workers", type=int, default=4)
    ap.add_argument("--lr", type=float, default=1e-4)
    ap.add_argument("--weight_decay", type=float, default=1e-4)
    ap.add_argument("--log_every", type=int, default=20)

    ap.add_argument("--lambda_forget", type=float, default=1.0)
    ap.add_argument("--beta_kl", type=float, default=0.1)
    ap.add_argument("--beta_npo", type=float, default=0.1)
    ap.add_argument("--gamma_neg", type=float, default=1.0)
    ap.add_argument("--use_forget_neg", action="store_true")

    ap.add_argument("--seed", type=int, default=42)
    args = ap.parse_args()

    set_seed(args.seed)

    if args.mode == "finetune":
        train_finetune_clip(args)
    else:
        if not args.pau_root:
            raise ValueError("--pau_root is required for PAU mode")
        train_pau_clip(args)


if __name__ == "__main__":
    main()
